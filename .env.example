# Haunted Halls engine local runtime settings.
# Copy to .env and fill in local values. Never commit real credentials.
# This file is read from the host at runtime (directly or via Docker Compose
# env_file) and is not copied into the Docker image.

# Shared internal service credential; must match the Next.js BFF value.
INTERNAL_ENGINE_SERVICE_TOKEN=generate-with-openssl-do-not-commit

# Required application runtime model access. A non-whitespace key is required
# at startup; startup does not make a provider request. Never commit a real key.
# AI_ENABLED is only an explicit opt-in for live eval runs, not runtime behavior.
AI_ENABLED=false
OPENAI_API_KEY=
DEFAULT_MODEL_NAME=

# Local database. Docker Compose overrides this with the container SQLite path.
DATABASE_URL=sqlite:///./data/haunted_halls.db

# OpenTelemetry tracing is disabled by default. Production uses ADC and the
# Google Cloud Telemetry API; never put credentials or a real project ID here.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=haunted-halls-engine
OTEL_SERVICE_VERSION=
OTEL_DEPLOYMENT_ENVIRONMENT=
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=telemetry.googleapis.com:443
OTEL_GCP_PROJECT_ID=
