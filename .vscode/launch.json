    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: FastAPI (dev)",
            "type": "debugpy",
            "request": "launch",
            "module": "fastapi",
            "cwd": "${workspaceFolder}",
            "args": [
                "dev",
                "app/main.py"
            ],
            "subProcess": true,
            "jinja": true
        }
    ]
}